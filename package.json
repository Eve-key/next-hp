{
  "name": "next-hp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/preview.mjs",
    "lint": "eslint",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test --project=e2e",
    "test:vrt": "playwright test --project=vrt --update-snapshots=none",
    "test:vrt:update": "playwright test --project=vrt --update-snapshots=all"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "serve-handler": "6.1.6",
    "typescript": "^5"
  },
  "type": "module"
}
